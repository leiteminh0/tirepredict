FROM python:3.12-slim

WORKDIR /app

# Dependências do sistema para psycopg2-binary
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copia e instala dependências Python antes do código
# (camada cacheada enquanto requirements.txt não mudar)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o restante do projeto
COPY backend/ ./backend/
COPY alembic/ ./alembic/
COPY alembic.ini .

# Executa migrations e sobe o servidor
# O seed é opcional — rode via POST /admin/seed após subir
CMD alembic upgrade head && \
    uvicorn backend.main:app --host 0.0.0.0 --port 8080
