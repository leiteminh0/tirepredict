# Copy para .env para desenvolvimento local
# NO RAILWAY: Use o dashboard Variables, não commit .env real!
# Todos os valores abaixo são EXEMPLOS FALSOS. Troque antes de usar.

# Requerido: PostgreSQL local (desenvolvimento sem Docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tirepredict

# ── Docker Compose (docker compose up) ───────────────────────────────────────
# O docker-compose.yml só tem ${VAR}: estes valores vêm daqui.
# POSTGRES_PASSWORD e WRITE_API_TOKEN são obrigatórias — o compose aborta sem elas.
# POSTGRES_USER e POSTGRES_PASSWORD formam a DATABASE_URL montada pelo compose.
POSTGRES_DB=tirepredict
POSTGRES_USER=tirepredict
POSTGRES_PASSWORD=troque-esta-senha-forte
# WRITE_API_TOKEN e ADMIN_SEED_TOKEN declarados mais abaixo também são lidos pelo compose.

# MQTT / HiveMQ Cloud
# Substitua pelo host do seu cluster — o painel do HiveMQ Cloud mostra o hostname.
MQTT_BROKER=seu-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=SEU_USUARIO_MQTT
MQTT_PASSWORD=SUA_SENHA_MQTT
MQTT_TOPIC=tcc/tpms/pneu1

# Frontend autorizado a chamar a API (separe varios enderecos por virgula)
CORS_ORIGINS=http://localhost:5173

# Token usado uma unica vez para POST /admin/seed (envie no header X-Admin-Token)
ADMIN_SEED_TOKEN=troque-por-um-token-longo

# Protege insercoes manuais pela API (header X-API-Token).
# Gere um valor longo e aleatorio para producao.
WRITE_API_TOKEN=troque-por-um-token-longo-e-aleatorio

# Regras de alerta centralizadas no backend
ALERT_PRESSURE_THRESHOLD=30
DB_WRITE_RETRIES=3

# Tuning de pool (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
