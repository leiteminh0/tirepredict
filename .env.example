# Copy this file to .env for local development. In Railway, set these as
# service environment variables instead (Variables tab) — do not commit a
# real .env file.

# Required: PostgreSQL connection string. Provision a Postgres plugin on
# Railway and use its DATABASE_URL, or point at your own instance.
# Falls back to a local SQLite file if unset — not suitable for production.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: MQTT broker connection. If MQTT_HOST is unset, the MQTT
# subscriber is disabled and the app runs without it.
MQTT_HOST=
MQTT_PORT=1883

# Optional: SQLAlchemy connection pool tuning (PostgreSQL only).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

