FROM node:20-alpine AS build

WORKDIR /app

# ARG recebido do docker-compose (VITE_API_URL)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Servir o build estático com um servidor leve ──────────────────────────
FROM node:20-alpine AS serve

WORKDIR /app

RUN npm install -g serve@14

COPY --from=build /app/dist ./dist

EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]
